// Copy to config.h and fill in. config.h is gitignored: it holds the WiFi and
// broker credentials for one physical node.
#pragma once

#define WIFI_SSID "my-wifi"
#define WIFI_PASSWORD "my-wifi-password"

// The gateway's broker on the local network. This is the LAN address of the
// machine running docker compose, never localhost or 127.0.0.1: those point
// the node at itself. Find it with `ipconfig getifaddr en0` on macOS.
#define MQTT_HOST "192.168.1.10"
#define MQTT_PORT 1883
#define MQTT_USERNAME "node-dev"
#define MQTT_PASSWORD "node-dev-password"

// Optional. Without this the node derives a stable key from its MAC address,
// so several nodes can share one gateway without per-device configuration.
// #define SENSOR_KEY "balcony-1"

// Optional. Must be at least 2000 ms, the DHT22's minimum sampling interval.
// #define PUBLISH_INTERVAL_MS 30000

// Soil sensor calibration. The firmware already defaults to this project's
// measured probe (3200 dry, 1510 wet). Override only for a different probe:
// note the raw ADC value in air and submerged, from the serial monitor.
// #define SOIL_RAW_DRY 3200
// #define SOIL_RAW_WET 1510
