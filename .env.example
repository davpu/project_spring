# Copy to .env for local development.
POSTGRES_USER=spring
POSTGRES_PASSWORD=spring
POSTGRES_DB=spring
POSTGRES_PORT=5433
DATABASE_URL=postgres://spring:spring@localhost:5433/spring

MQTT_PORT=1883
MQTT_ADMIN_USER=api
MQTT_ADMIN_PASSWORD=api-dev-password

# Gateway (Node-RED). Pairing will hand these to the gateway once the API
# implements it; until then create the broker client by hand, see README.
NODE_RED_PORT=1880
GATEWAY_ID=
MQTT_GATEWAY_USER=gateway-dev
MQTT_GATEWAY_PASSWORD=gateway-dev-password
